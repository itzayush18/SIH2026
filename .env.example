# OILTRACE environment — real credentials switch adapters from SIMULATION to ONLINE.
# Never commit a filled copy of this file.

# ---- Copernicus Data Space (Sentinel-1/2 SAR & optical) ----
# Register: https://dataspace.copernicus.eu/
CDSE_USER=
CDSE_PASSWORD=

# ---- Copernicus Marine (currents, waves, SST) ----
# Register: https://marine.copernicus.eu/
CMEMS_USER=
CMEMS_PASSWORD=

# ---- ECMWF Climate Data Store (ERA5 wind) ----
# https://cds.climate.copernicus.eu/api-how-to
CDS_UID=
CDS_KEY=

# ---- AIS (pick the source you have access to) ----
AISSTREAM_KEY=                    # free live WebSocket AIS — https://aisstream.io (no India coverage)
DATADOCKED_KEY=                   # paid REST AIS, satellite+global incl. India — https://datadocked.com
VESSELAPI_KEY=                    # REST AIS, global incl. India, free tier 150/mo — https://vesselapi.com
AISHUB_USER=
SPIRE_TOKEN=                      # commercial sat-AIS

# ---- Notifications (all optional) ----
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
